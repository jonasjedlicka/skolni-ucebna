<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Plán pro macOS (launchd): každý den v 6:30 spustí stahni.py.
  Když je Mac v tu dobu uspaný, spustí se hned po probuzení.

  Zapnutí:  cp stahovani/cz.ucebna.stahovani.plist ~/Library/LaunchAgents/
            launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/cz.ucebna.stahovani.plist
  Vypnutí:  launchctl bootout gui/$(id -u)/cz.ucebna.stahovani
            rm ~/Library/LaunchAgents/cz.ucebna.stahovani.plist
  Spustit hned teď:  launchctl kickstart gui/$(id -u)/cz.ucebna.stahovani
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cz.ucebna.stahovani</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/jonasjedlicka/skolni-ucebna/.venv/bin/python</string>
    <string>/Users/jonasjedlicka/skolni-ucebna/stahovani/stahni.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/jonasjedlicka/skolni-ucebna</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <!-- Sem se zapisuje, co skript vypsal, ať se dá zpětně zjistit, co se stalo -->
  <key>StandardOutPath</key>
  <string>/Users/jonasjedlicka/skolni-ucebna/stahovani/posledni-behy.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jonasjedlicka/skolni-ucebna/stahovani/posledni-behy.log</string>
</dict>
</plist>
