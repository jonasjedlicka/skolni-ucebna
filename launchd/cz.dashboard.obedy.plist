<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Obědy (stahovani/obedy.py): v pátek v 8:00 objedná příští týden.
  - StartCalendarInterval: pátek 8:00. Když Mac v tu chvíli spí, macOS úlohu
    spustí hned po probuzení.
  - RunAtLoad: po zapnutí Macu / přihlášení (kdyby byl v pátek vypnutý).
  - StartInterval: pak každou hodinu – kdyby jídelníček ještě nebyl zveřejněný.
  Skript sám pozná, jestli už je týden objednaný; když ne a uzávěrka prošla,
  napíše to do dashboardu.
  Instaluje ho launchd/zapnout.sh.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cz.dashboard.obedy</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJEKT__/.venv/bin/python</string>
    <string>__PROJEKT__/stahovani/obedy.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJEKT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>5</integer>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>__DATA__/logy/obedy.log</string>
  <key>StandardErrorPath</key>
  <string>__DATA__/logy/obedy.log</string>
</dict>
</plist>
